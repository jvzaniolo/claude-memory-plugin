{
  "name": "memory",
  "description": "Memória de longo prazo curada para o Claude Code: um worker headless grava as conclusões duráveis de cada sessão fora da sua thread, dossiês mantêm o índice enxuto, e uma consolidação diária deixa o que envelhece virar o essencial sem apagar nada.",
  "version": "0.2.1",
  "author": {
    "name": "João Vitor Zaniolo"
  },
  "keywords": [
    "memory",
    "long-term",
    "consolidation",
    "markdown"
  ],
  "commands": "./commands/",
  "skills": "./skills/",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/checkpoint.sh\"",
            "timeout": 15,
            "statusMessage": "Verificando checkpoint de memória…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/daily-consolidation.sh\"",
            "timeout": 5,
            "statusMessage": "Consolidação diária de memória…"
          }
        ]
      }
    ]
  }
}
